<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework theme only: no AppCompat/Material Components dependency. -->
    <style name="Theme.ClipSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cs_background</item>
        <item name="android:statusBarColor">@color/cs_background</item>
        <item name="android:navigationBarColor">@color/cs_background</item>
        <item name="android:colorPrimary">@color/cs_accent_blue</item>
        <item name="android:colorAccent">@color/cs_accent_teal</item>
        <item name="android:colorControlActivated">@color/cs_accent_teal</item>
        <item name="android:textColorPrimary">@color/cs_text_primary</item>
        <item name="android:textColorSecondary">@color/cs_text_secondary</item>
        <item name="android:textColorHint">@color/cs_input_hint</item>
    </style>

    <style name="Theme.ClipSync.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="ClipSync.CardTitle" parent="">
        <item name="android:textColor">@color/cs_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="ClipSync.FieldLabel" parent="">
        <item name="android:textColor">@color/cs_text_label</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="ClipSync.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/cs_text_primary</item>
        <item name="android:textColorHint">@color/cs_input_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="ClipSync.Button" parent="">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ClipSync.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/cs_text_primary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ClipSync.Switch" parent="">
        <item name="android:textColor">@color/cs_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="ClipSync.Hint" parent="">
        <item name="android:textColor">@color/cs_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
