<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors ios-app/ClipSync/ContentView.swift: header, status, connection,
     clipboard, then the Android-only behaviour settings. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/cs_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textColor="@color/cs_text_secondary"
            android:textSize="14sp" />

        <!-- Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/statusHalo"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/dot" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:background="@drawable/dot" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cs_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:textColor="@color/cs_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView
                style="@style/ClipSync.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection" />

            <TextView
                style="@style/ClipSync.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/device_name" />

            <EditText
                android:id="@+id/editDeviceName"
                style="@style/ClipSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/device_name_hint"
                android:importantForAutofill="no"
                android:inputType="textPersonName" />

            <TextView
                style="@style/ClipSync.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_url" />

            <EditText
                android:id="@+id/editServerUrl"
                style="@style/ClipSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/server_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView
                style="@style/ClipSync.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secret_key" />

            <EditText
                android:id="@+id/editSecretKey"
                style="@style/ClipSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/secret_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnSave"
                style="@style/ClipSync.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/save_and_connect" />
        </LinearLayout>

        <!-- Clipboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView
                style="@style/ClipSync.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clipboard" />

            <Button
                android:id="@+id/btnSendClipboard"
                style="@style/ClipSync.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/send_clipboard_action" />

            <LinearLayout
                android:id="@+id/lastReceivedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLastReceivedFrom"
                    style="@style/ClipSync.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" />

                <ImageView
                    android:id="@+id/ivLastImage"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="8dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/bg_clip_preview"
                    android:contentDescription="@string/last_image"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvLastReceived"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_clip_preview"
                    android:ellipsize="end"
                    android:maxLines="4"
                    android:textColor="@color/cs_text_primary"
                    android:textIsSelectable="false"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnCopyLast"
                    style="@style/ClipSync.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/copy_to_clipboard" />
            </LinearLayout>
        </LinearLayout>

        <!-- Behaviour (Android only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView
                style="@style/ClipSync.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/behaviour" />

            <Switch
                android:id="@+id/switchService"
                style="@style/ClipSync.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/run_in_background" />

            <TextView
                style="@style/ClipSync.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/run_in_background_hint" />

            <Switch
                android:id="@+id/switchSendNotificationAction"
                style="@style/ClipSync.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_send_button" />

            <Switch
                android:id="@+id/switchSyncImages"
                style="@style/ClipSync.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_images" />

            <Switch
                android:id="@+id/switchImagesWifiOnly"
                style="@style/ClipSync.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/images_wifi_only" />

            <TextView
                style="@style/ClipSync.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/images_wifi_only_hint" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/cs_input_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
