<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="ClipSync"
            android:textColor="#e7eef8"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Service: Stopped"
            android:textColor="#95a3b8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Name"
            android:textColor="#b8c3d4"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#3c4a5f"
            android:hint="e.g. My Pixel"
            android:textColor="#ffffff"
            android:textColorHint="#66758a" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server URL"
            android:textColor="#b8c3d4"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#3c4a5f"
            android:hint="wss://your-server.example"
            android:inputType="textUri"
            android:textColor="#ffffff"
            android:textColorHint="#66758a" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secret Key"
            android:textColor="#b8c3d4"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editSecretKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#3c4a5f"
            android:hint="Your shared secret"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#66758a" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#4a90d9"
            android:text="Save Settings"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#00a6a6"
            android:text="Enable Clipboard Bridge"
            android:textColor="#ffffff" />

        <Switch
            android:id="@+id/switchService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run ClipSync in Background"
            android:textColor="#e7eef8"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
